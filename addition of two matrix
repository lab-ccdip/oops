#include <iostream.h>
#include <conio.h>

class Array_ex
{
    public:
        int add[10][10], A[10][10], B[10][10];
        int row1, row2, col1, col2;

        void input();
};

void Array_ex::input()
{
    clrscr();

    cout << "Enter number of rows for matrix A: ";
    cin >> row1;

    cout << "Enter number of columns for matrix A: ";
    cin >> col1;

    cout << "Enter number of rows for matrix B: ";
    cin >> row2;

    cout << "Enter number of columns for matrix B: ";
    cin >> col2;

    if(row1 == row2 && col1 == col2)
    {
        cout << "\nEnter A matrix elements:\n";

        for(int i = 0; i < row1; i++)
        {
            for(int j = 0; j < col1; j++)
            {
                cin >> A[i][j];
            }
        }

        cout << "\nEnter B matrix elements:\n";

        for(int i = 0; i < row2; i++)
        {
            for(int j = 0; j < col2; j++)
            {
                cin >> B[i][j];
            }
        }

        cout << "\nAddition of Matrix:\n";

        for(int i = 0; i < row1; i++)
        {
            for(int j = 0; j < col1; j++)
            {
                add[i][j] = A[i][j] + B[i][j];
                cout << add[i][j] << "\t";
            }
            cout << endl;
        }
    }
    else
    {
        cout << "\nMatrix does not perform addition.";
    }
}

int main()
{
    clrscr();
    Array_ex a;
    a.input();

    getch();
    return 0;
}
