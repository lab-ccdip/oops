#include <iostream.h>
#include <conio.h>
#include <string.h>

class StringOperations
{
    private:
        char str1[50], str2[50];

    public:
        void input();
        void length();
        void concatenate();
        void compare();
        void copy();
        void reversestring();
};

void StringOperations::input()
{
    cout << "Enter first string: ";
    cin >> str1;

    cout << "Enter second string: ";
    cin >> str2;
}

void StringOperations::length()
{
    cout << "\nLength of first string: "
         << strlen(str1);
}

void StringOperations::concatenate()
{
    char concat[100];

    strcpy(concat, str1);
    strcat(concat, str2);

    cout << "\nConcatenated string: " << concat;
}

void StringOperations::compare()
{
    if(strcmp(str1, str2) == 0)
        cout << "\nBoth strings are equal.";
    else
        cout << "\nStrings are not equal.";
}

void StringOperations::copy()
{
    char copy[50];

    strcpy(copy, str1);

    cout << "\nCopied string: " << copy;
}

void StringOperations::reversestring()
{
    char rev[50];

    strcpy(rev, str1);
    strrev(rev);

    cout << "\nReversed first string: " << rev;
}

int main()
{
    clrscr();

    StringOperations s;

    s.input();
    s.length();
    s.concatenate();
    s.compare();
    s.copy();
    s.reversestring();

    cout << "\n\nProgram executed successfully.";

    getch();
    return 0;
}
