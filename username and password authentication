#include <iostream.h>
#include <conio.h>
#include <string.h>

class Login
{
    private:
        char username[20];
        char password[20];

    public:
        void login()
        {
            strcpy(username, "admin");
            strcpy(password, "1234");

            int attempts = 0;
            char user[20], pass[20];
            int success = 0;

            while(attempts < 3)
            {
                cout << "Enter Username: ";
                cin >> user;

                cout << "Enter Password: ";
                cin >> pass;

                if(strcmp(user, username) == 0 &&
                   strcmp(pass, password) == 0)
                {
                    cout << "\nLogin Successful!" << endl;
                    success = 1;
                    break;
                }
                else
                {
                    attempts++;
                    cout << "Invalid Username or Password." << endl;
                    cout << "Attempts left: "
                         << (3 - attempts) << endl;
                }
            }

            if(success == 0)
            {
                cout << "\nToo many failed attempts. Access Denied!"
                     << endl;
            }
        }
};

int main()
{
    clrscr();
    Login loginSystem;
    loginSystem.login();

    getch();
    return 0;
}
